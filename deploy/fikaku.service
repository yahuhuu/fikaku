[Unit]
Description=Fikaku Next.js app
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/fikaku
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/ubuntu/workspace/fikaku/.env
ExecStart=/home/ubuntu/.local/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
